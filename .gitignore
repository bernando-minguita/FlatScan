__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
*.egg-info/
*.egg
.installed.cfg
MANIFEST
pip-wheel-metadata/
.eggs/
eggs/

# ------------------------------------------------------------ Virtual envs
.venv/
.venv*/
venv/
venv*/
ENV/
env/
.env
.env.*
!.env.example
.python-version

# ------------------------------------------------------- Test / tool output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
report.xml
junit*.xml
pytest_*.txt
pytest_out.txt
pytest_err.txt
